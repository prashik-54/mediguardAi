# Backend configuration (copy to .env — never commit real values)
MONGODB_URI=mongodb url of database 
MONGODB_NAME=ddi_framework
# REQUIRED when APP_ENV=production (server refuses to start on the dev default).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_TTL_SECONDS=604800
APP_ENV=development

# --- First account on a fresh deployment -----------------------------------------------------
# "admin" (Platform Admin) and "administrator" (Hospital Administrator) accounts can never be
# created through public sign-up (see app.modules.module_auth.SIGNUP_ROLES) — only an existing
# admin/administrator can create one. On an empty database that's a chicken-and-egg problem, so:
# set BOTH of these and the server creates exactly ONE real Platform Admin account at startup —
# no demo hospital, no sample patients, no shared password. Runs once, only while the `users`
# collection is empty; safe to leave set permanently.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Admin