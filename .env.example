# Backend configuration (copy to .env — never commit real values)
MONGODB_URI=mongodb://localhost:27017
MONGODB_NAME=ddi_framework
# REQUIRED when APP_ENV=production (server refuses to start on the dev default).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_TTL_SECONDS=604800
APP_ENV=development


BOOTSTRAP_ADMIN_EMAIL=platform admin email
BOOTSTRAP_ADMIN_PASSWORD=platform admin password
BOOTSTRAP_ADMIN_NAME=Platform Admin
